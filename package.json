{
  "name": "cloudflare-os-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "postinstall": "cfos install",
    "install:submodule": "cfos install",
    "cfos": "cfos",
    "build": "cfos install --check && vp run --filter \"!cloudflare-os-starter\" --cache build",
    "test": "cfos install --check && vp run --filter \"!cloudflare-os-starter\" --cache test",
    "lint:check": "vp lint",
    "lint:fix": "vp lint --fix",
    "lint": "pnpm run lint:check && pnpm run build",
    "check": "cfos check",
    "deploy": "cfos deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@maximoguk/cfos": "workspace:*",
    "@types/node": "26.1.0",
    "cf": "1.0.0-beta.17",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
