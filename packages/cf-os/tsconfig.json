// Type-checks the CLI. Nothing here is compiled for the repository's own use: the `cf-os` bin is
// `src/main.ts`, which `node` runs directly, stripping the types. `erasableSyntaxOnly` is what keeps
// that a guarantee rather than a hope. `tsconfig.build.json` is the compile, for the packed tarball
// only.
//
// Checked by this package's `build` task, which `pnpm lint` and `pnpm build` run.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Node resolves these specifiers for real, unlike the Worker packages' bundled "bundler" mode,
    // so imports name the file on disk (`./deployment-config.ts`) and need the extension allowed.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    // The root sets allowJs; nothing here is JS, and checking the submodule's is not this config's
    // job.
    "checkJs": false
  },
  "include": ["src/**/*.ts", "generator/**/*.ts", "vite.config.ts"]
}
